@startuml
title CaseflowAI - Enterprise Agentic AI Dispute Management Canonical Data Model

skinparam class {
    BackgroundColor #FFFDF0
    BorderColor #9E3D3D
    ArrowColor #9E3D3D
}

class Case {
    +caseId: UUID
    +caseReference: String
    +channel: String
    +countryCode: String
    +submissionChannel: String
    +currentStatus: String
    +currentStage: String
    +priority: String
    +createdDateTime: DateTime
    +closedDateTime: DateTime
}

class Customer {
    +cifNo: String
    +customerName: String
    +customerType: String
    +nricNo: String
    +email: String
    +mobileNo: String
}

class Address {
    +addressLine1: String
    +addressLine2: String
    +postalCode: String
    +country: String
}

class Card {
    +cardId: UUID
    +maskedPan: String
    +cardScheme: String
    +cardType: String
    +productType: String
    +accountType: String
    +cardStatus: String
}

class Transaction {
    +transactionId: String
    +arn: String
    +transactionDate: Date
    +postingDate: Date
    +transactionAmount: Decimal
    +disputeAmount: Decimal
    +currency: String
    +mcc: String
    +authorizationCode: String
    +posMode: String
    +transactionType: String
    +recurringFlag: Boolean
}

class Merchant {
    +merchantId: String
    +merchantName: String
    +merchantCountry: String
    +merchantCategoryCode: String
    +riskRating: String
}

class Dispute {
    +disputeId: UUID
    +disputeType: String
    +natureOfDispute: String
    +customerNarrative: String
    +fraudType: String
    +fraudReportingDate: Date
}

class DisputeStage {
    +stageId: UUID
    +stageType: String
    +status: String
    +startDateTime: DateTime
    +endDateTime: DateTime
}

class Evidence {
    +evidenceId: UUID
    +documentId: String
    +documentType: String
    +stageType: String
    +uploadedBy: String
    +fileName: String
    +documentUri: String
    +uploadTime: DateTime
    +verificationStatus: String
}

class DocumentAnalysis {
    +analysisId: UUID
    +validationScore: Decimal
    +tamperingDetected: Boolean
    +ocrStatus: String
    +analysisDateTime: DateTime
}

class WorkflowTask {
    +taskId: UUID
    +taskType: String
    +assignedRole: String
    +assignedUser: String
    +status: String
    +dueDate: DateTime
}

class StatusHistory {
    +historyId: UUID
    +oldStatus: String
    +newStatus: String
    +changedBy: String
    +changedDateTime: DateTime
}

class TimelineEvent {
    +eventId: UUID
    +eventType: String
    +sourceSystem: String
    +description: String
    +eventTime: DateTime
}

class CaseProcessingCheckpoint {
    +checkpointId: UUID
    +agentType: String
    +status: String
    +completedDateTime: DateTime
}

class SecurityContext {
    +ipAddress: String
    +deviceId: String
    +deviceFingerprint: String
    +browser: String
    +operatingSystem: String
}

class Authentication {
    +threeDSAuthenticated: Boolean
    +otpSent: Boolean
    +otpValidated: Boolean
}

class Location {
    +country: String
    +city: String
}

class FinancialAdjustment {
    +adjustmentId: UUID
    +adjustmentType: String
    +amount: Decimal
    +currency: String
    +approvalStatus: String
    +postingStatus: String
}

class AgentExecution {
    +executionId: UUID
    +agentType: String
    +status: String
    +startTime: DateTime
    +endTime: DateTime
    +durationMs: Long
    +retryCount: Integer
    +errorMessage: String
}

class AgentAssessment {
    +assessmentId: UUID
    +agentType: String
    +agentVersion: String
    +executionStatus: String
    +score: Integer
    +confidence: Decimal
    +finding: String
    +recommendation: String
    +reasoningJson: JSON
    +createdDateTime: DateTime
}

class RuleEvaluation {
    +evaluationId: UUID
    +ruleName: String
    +ruleSource: String
    +ruleVersion: String
    +disputeCategory: String
    +reasonCode: String
    +eligibilityResult: String
    +evaluationResult: String
    +score: Decimal
}

class RequiredEvidence {
    +requiredEvidenceId: UUID
    +reasonCode: String
    +documentType: String
    +mandatoryFlag: Boolean
}

class EvidenceVerification {
    +verificationId: UUID
    +sourceSystem: String
    +verificationType: String
    +result: String
    +verificationTime: DateTime
}

class FraudAssessment {
    +fraudAssessmentId: UUID
    +fraudScore: Integer
    +riskLevel: String
    +fraudRemarks: String
    +assessmentDateTime: DateTime
}

class ConsensusDecision {
    +decisionId: UUID
    +recommendedAction: String
    +reasonCode: String
    +confidence: Integer
    +fraudScore: Integer
    +evidenceCompleteness: Integer
    +arbitrationProbability: Integer
    +decisionReason: String
    +decisionDateTime: DateTime
}

class AIConversation {
    +conversationId: UUID
    +agentType: String
    +promptHash: String
    +responseHash: String
    +modelVersion: String
    +timestamp: DateTime
}

class ExternalSystemInteraction {
    +interactionId: UUID
    +systemName: String
    +requestType: String
    +responseStatus: String
    +requestTime: DateTime
    +responseTime: DateTime
}

' Case top-level relationships
Case "1" *-- "1" Customer
Case "1" *-- "1" Transaction
Case "1" *-- "1" Dispute
Case "1" *-- "1" Evidence
Case "1" *-- WorkflowTask
Case "1" *-- StatusHistory
Case "1" *-- TimelineEvent
Case "1" *-- CaseProcessingCheckpoint
Case "1" *-- SecurityContext
Case "1" *-- FinancialAdjustment
Case "1" *-- AgentExecution
Case "1" *-- RuleEvaluation
Case "1" *-- EvidenceVerification
Case "1" *-- "0..1" FraudAssessment
Case "1" *-- ConsensusDecision
Case "1" *-- AIConversation
Case "1" *-- ExternalSystemInteraction

' Sub-entity relationships
Customer "1" *-- "1" Address
Customer "1" *-- "1" Card
Transaction "1" *-- "1" Merchant
Dispute "1" *-- "1" DisputeStage
Evidence "1" *-- "0..1" DocumentAnalysis
SecurityContext "1" *-- "1" Authentication
SecurityContext "1" *-- "1" Location
AgentExecution "1" *-- "0..*" AgentAssessment
RuleEvaluation "1" *-- "1" RequiredEvidence

@enduml
